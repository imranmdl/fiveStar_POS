{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "docker/**",
      "railway.json",
      "5star-frontend/**",
      "spice-api/backend/**",
      "spice-api/database/migrations/**",
      "spice-api/database/rollback/**",
      "spice-api/database/seeds/**"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
